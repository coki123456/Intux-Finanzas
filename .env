# ==========================================
# Configuración Front-End (Vite / React)
# ==========================================
# Estas variables deben cargarse en la configuración 
# de entorno (Environment) del servicio Front-End en Easypanel.

# URL de tu servicio PostgREST en Easypanel (ej: https://api.tudominio.com)
VITE_API_URL="http://localhost:3000"

# La misma clave secreta (mínimo 32 caracteres) que pusiste en PGRST_JWT_SECRET 
# en la configuración de PostgREST dentro de Easypanel.
VITE_PGRST_JWT_SECRET="3f1a9b2c8e7d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a"